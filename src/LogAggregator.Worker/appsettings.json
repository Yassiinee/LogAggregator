{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "LogSource": {
    "ServerBaseUrl": "http://localhost:5007",

    // Auto: tail FilePath if it exists at startup, otherwise generate synthetic traffic.
    // Set to "File" to always tail (waiting for the file to appear) or "Simulate" to force the demo feed.
    //
    // FilePath is relative to the worker's working directory, so the default below does not exist
    // out of the box and Auto falls back to the simulator. To tail the repo's sample file, run with
    //   LogSource__Mode=File LogSource__FilePath="<repo>/samples/app.log.txt"
    "Mode": "Auto",
    "FilePath": "logs/app.log.txt",
    "ReadExistingContentOnStartup": false,
    "FilePollMilliseconds": 400,
    "SimulationIntervalMilliseconds": 800,
    "MaxBatchSize": 50
  }
}
