# Normalise line endings so contributors on Windows, macOS and Linux don't produce
# whole-file diffs. Text files are stored LF in the repository and checked out native.
* text=auto

# Keep these LF even on Windows checkouts — shell scripts and web assets break otherwise.
*.sh          text eol=lf
*.js          text eol=lf
*.css         text eol=lf
*.json        text eol=lf

# Windows-only scripts must stay CRLF.
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

# Treat these as text so diffs are readable.
*.cs          text diff=csharp
*.razor       text
*.csproj      text
*.slnx        text
*.md          text
*.txt         text

# Binary — never touch, never try to diff.
*.png         binary
*.jpg         binary
*.ico         binary
*.pdf         binary
*.dll         binary
*.exe         binary
